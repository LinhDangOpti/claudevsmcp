{
  "name": "azure-devops-mcp-server",
  "version": "1.0.0",
  "description": "MCP Server for Azure DevOps integration",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "refresh": "npm run build && node dist/scripts/refresh-cache.js",
    "query": "npm run build && node dist/scripts/query-cache.js",
    "cli": "npm run build && node dist/scripts/cli.js",
    "analyze-pr": "npm run build && node dist/scripts/analyze-pr-files.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test-webhook": "node test-teams-webhook.js",
    "test:pr": "npm run build && node dist/scripts/test-pr-extraction.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "bin": {
    "azure-devops-mcp": "./dist/index.js"
  },
  "keywords": [
    "mcp",
    "azure-devops",
    "copilot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.1",
    "azure-devops-node-api": "^15.1.1",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  }
}
